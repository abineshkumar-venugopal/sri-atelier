# Contact form email (app/actions/contact.ts). Copy to .env.local and fill in.

# resend.com → API Keys → Create API Key (starts with re_)
RESEND_API_KEY=

# Inbox that receives website enquiries
CONTACT_TO_EMAIL=

# Optional sender. Leave empty to use Resend's test sender, which can only
# deliver to the address the Resend account was created with. For real use,
# verify the studio's domain in Resend and set e.g.:
# CONTACT_FROM_EMAIL=Sri Atelier Website <enquiries@sriatelier.com>
CONTACT_FROM_EMAIL=
